{
  "name": "@quill/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "node --watch --env-file=../../.env dist/index.js",
    "start": "node dist/index.js",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/session": "10.0.1",
    "@quill/database": "workspace:*",
    "@quill/services": "workspace:*",
    "@quill/shared": "workspace:*",
    "zod": "3.25.76",
    "fastify": "4.29.0"
  },
  "devDependencies": {
    "pino-pretty": "13.0.0",
    "typescript": "5.7.2"
  }
}
