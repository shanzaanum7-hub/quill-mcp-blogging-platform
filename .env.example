# ============================================================
# Quill — Environment Variable Reference
# Copy this file to .env and fill in the values.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# --- Required ---

# Runtime environment
# Values: development | production | test
NODE_ENV=development

# Absolute path to the SQLite database file
# Docker: /data/db/quill.db
# Local:  /absolute/path/to/quill.db
DATABASE_PATH=/tmp/quill.db

# Session signing secret — minimum 64 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_this_with_a_64_char_or_longer_random_secret_string_here_!!

# --- Optional (shown with defaults) ---

# Port for the Fastify REST API server
PORT_API=3001

# Port for the MCP server
PORT_MCP=3002

# Rate limit for authenticated API routes (requests per minute per key)
RATE_LIMIT_API_RPM=120

# Rate limit for MCP routes (requests per minute per API key)
RATE_LIMIT_MCP_RPM=60

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Log level for Pino logger
# Values: trace | debug | info | warn | error
LOG_LEVEL=info
